# DesignLab environment configuration (copy to .env — never commit real values)

# ---------------------------------------------------------------------------
# Claude
# ---------------------------------------------------------------------------
# DesignLab drives agents through the locally installed `claude` CLI.
# If your CLI is already authenticated (`claude auth`), you need nothing here.
# Only set an API key if you want DesignLab to run under API-key auth instead.
# ANTHROPIC_API_KEY=

# Optional override for the Claude Code executable used by the agent runner.
# DESIGNLAB_CLAUDE_BIN=claude

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
# Used only for pushing design branches and reading Actions build status.
# Needs `repo` + `actions:read` scope on the TARGET repository.
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# debug | info | warn | error
# DESIGNLAB_LOG_LEVEL=info
# Set to 1 to force plain (non-coloured) log output.
# DESIGNLAB_NO_COLOR=
